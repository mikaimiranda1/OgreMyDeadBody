# Keep line endings consistent between Windows and Mac teammates
* text=auto

# Unity text files (scenes, prefabs, assets, meta) - always LF so diffs stay clean
*.cs      text diff=csharp eol=lf
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.meta    text eol=lf

# Binary files - never try to diff/merge these as text
*.fbx  binary
*.obj  binary
*.blend binary
*.png  binary
*.jpg  binary
*.tga  binary
*.psd  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary

# --- OPTIONAL: Git LFS ---
# Only turn this on if a file gets near GitHub's 100 MB limit or the repo gets big.
# Every teammate must run `git lfs install` once first. Then delete the "binary" lines
# above for these types and uncomment:
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.png filter=lfs diff=lfs merge=lfs -text
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text
